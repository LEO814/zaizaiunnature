-- INKWAVE monster SFX. Synthesizers adapted from Jayden Davis (2026), MIT.
-- The complete upstream notice is preserved in audio/LICENSE and audio_source/LICENSE.
-- This bank contains only this monster's one-shot SFX; it never starts music or a match.
local Bank={sample_rate=22050,encoding='g711_mulaw_u8_base64',clips={
__CLIPS__
}}
local alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local lookup={}
for i=1,#alphabet do lookup[alphabet:sub(i,i)]=i-1 end
local function unbase64(encoded)
 local out,acc,bits={},0,0
 for i=1,#encoded do
  local v=lookup[encoded:sub(i,i)]
  if v then
   acc=acc*64+v;bits=bits+6
   if bits>=8 then bits=bits-8;local divisor=2^bits;local b=math.floor(acc/divisor);out[#out+1]=string.char(b);acc=acc-b*divisor end
  end
 end
 return table.concat(out)
end
function Bank.decode_byte(encoded)
 local u=255-encoded;local sign=math.floor(u/128);local exponent=math.floor(u/16)%8;local mantissa=u%16
 local magnitude=((mantissa*8+132)*2^exponent)-132
 return (sign==1 and -magnitude or magnitude)/32768
end
-- step(budget,sink): sink(zero_based_sample_index,float_sample); returns done, written.
-- Sink may be typedArray:SetValue(value,index). Upload the complete array only when done.
function Bank.new_decoder(id)
 local clip=Bank.clips[id];if not clip then return nil,'UNKNOWN_CLIP' end
 local bytes=unbase64(clip.data)
 if #bytes~=clip.frames then return nil,'INVALID_FRAME_COUNT' end
 local decoder={sample_rate=Bank.sample_rate,total_frames=clip.frames,position=0,id=id}
 function decoder:step(budget,sink)
  if type(sink)~='function'then return false,0,'MISSING_SINK' end
  local stop=math.min(self.total_frames,self.position+math.max(1,math.floor(tonumber(budget)or 4096)))
  local first=self.position
  while self.position<stop do local index=self.position;sink(index,Bank.decode_byte(bytes:byte(index+1)));self.position=index+1 end
  return self.position==self.total_frames,self.position-first
 end
 return decoder
end
function Bank.decode(id)
 local decoder,reason=Bank.new_decoder(id);if not decoder then return nil,reason end
 local samples={};decoder:step(decoder.total_frames,function(index,value)samples[index+1]=value end)
 return samples,Bank.sample_rate
end
return Bank
